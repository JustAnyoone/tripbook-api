# Single image with the API and the React front-end, for hosts that run one container
# (Render's free plan can not forward private traffic between two services).
# The API serves the built front-end itself, so the browser sees one origin: no CORS, no proxy.
# For the three-container setup used locally, see Dockerfile and docker-compose.yml.

# Stage 1: build the React app
FROM node:22-alpine AS web
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Stage 2: build the jar with the built front-end inside it (Spring serves classpath:/static)
FROM eclipse-temurin:17-jdk AS build
WORKDIR /workspace
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw -B -q dependency:go-offline
COPY src src
COPY --from=web /app/dist src/main/resources/static
RUN ./mvnw -B -q package -DskipTests

# Stage 3: small runtime image, non-root
FROM eclipse-temurin:17-jre
RUN useradd --system --uid 10001 tripbook
USER tripbook
WORKDIR /app
COPY --from=build /workspace/target/*.jar app.jar
EXPOSE 8080
# Render's free plan has 512 MB: the serial collector and a capped metaspace keep the JVM inside it
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-XX:+UseSerialGC", "-XX:MaxMetaspaceSize=128m", "-jar", "app.jar"]
